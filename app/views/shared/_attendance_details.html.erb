<h3>Title: <span style="font-weight: lighter; font-size: smaller;"><%= attendance.meeting.title %></span></h3>
<h3>Date: <span style="font-weight: lighter; font-size: smaller;"><%= pretty_date(attendance.attendance_time) %></span></h3>
<h3>Attendance Time: <span style="font-weight: lighter; font-size: smaller;"><%= pretty_time(attendance.attendance_time) %> <%= link_to "Update Attendance Time", edit_attendance_path(attendance) if updatable %></span></h3>
<p><strong>Present: <%= attendance.count_status(:present) %>, Tardy: <%= attendance.count_status(:tardy) %>, Absent: <%= attendance.count_status(:absent) %></strong></p>
<%= link_to "Transfer Student Attendances to Populi", new_attendance_populi_transfer_path(@attendance) if updatable %>