<p><strong>Present: <%= facade.status_count(:present) %>, Tardy: <%= facade.status_count(:tardy) %>, Absent: <%= facade.status_count(:absent) %></strong></p>
<div class="list_of_instructors">
  <% if facade.instructor_zoom_aliases %>
    <h3>Instructors Present In Meeting:</h3>
    <% facade.instructor_zoom_aliases.each do |zoom_alias| %>
    <ul>
      <li><%= zoom_alias.name %></li>
    </ul>
    <% end %>
  <% else %>
    <p>No zoom aliases have been assigned as instructors yet.</p>
  <% end %>
</div>
<div class="assign_instructor_aliases">
  <% if facade.unassigned_zoom_aliases.any? %>
    <%= form_with model: [@attendance], url: attendance_instructor_path(@attendance), class: "alias-correction" do |f| %>
      <%= f.select :zoom_alias, facade.unassigned_zoom_aliases, {}, class: "alias-correction" %>
      <%= hidden_field_tag :turing_module_id, "#{facade.turing_module_id}" %>
      <%= f.submit "Save Zoom Alias As Instructor", class: "s-button alias-correction" %>
    <% end %>
  <% end %> 
</div>
<% if !facade.unassigned_zoom_aliases.empty? %>
  <p>Use the zoom alias fields in the table to correct student attendances.</p>
  <p>When attendance is correct, click the button below.</p>
<% else %>
  <p>All Zoom Aliases have been assigned.</p>
<% end %>
<%= link_to "Transfer Student Attendances to Populi", new_attendance_populi_transfer_path(facade.attendance), class: "s-button transfer-btn" if facade.updatable %>
<br>
<br>
<table id='student-attendances' class="sortable">
  <thead>
    <tr>
      <th>Student</th>
      <th>Join Time</th>
      <th>Status</th>
      <th>Duration (minutes)</th>
      <th>Zoom Aliases Used</th>
      <% if !facade.unassigned_zoom_aliases.empty? %>
        <th>Save a new Zoom Alias</th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% facade.student_attendances.each do |student_attendance| %>
      <tr id='student-attendance-<%= student_attendance.id %>' class='student-attendance'>
        <section id='student-<%= student_attendance.student.id %>'>
          <td><%= link_to student_attendance.student.name, student_path(student_attendance.student) %></td>
          <% if student_attendance.join_time %>
            <td><%= pretty_time(student_attendance.join_time) %></td>
          <% else %>
            <td>N/A</td>
          <% end %>
          <td class='<%= student_attendance.status %>'><%= student_attendance.status %></td>
          <td class='duration'><%= student_attendance.duration %></td>
          <td class="alias-used">
            <%= student_attendance.student.zoom_alias_names.to_sentence %>
            <%= link_to "Edit", student_path(student_attendance.student), class: "s-button danger alias-correction" %>
          </td>
          <% if !facade.alias_options_for(student_attendance.student).empty? %>
            <td id='student-aliases-<%= student_attendance.student.id %>'>
              <%= form_with model: [@attendance, student_attendance.student], class: "alias-correction" do |f| %>
                <%= f.select :zoom_alias, facade.alias_options_for(student_attendance.student), {}, class: "alias-correction" %>
                <%= f.submit "Save Zoom Alias", class: "s-button alias-correction-btn" %>
              <% end %>
          </td>
        <% end %>
        </section>
      </tr>
    <% end %>
  </tbody>
</table>
